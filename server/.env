PORT=3000

# Get your PostgreSQL connection URL from Neon.tech (or local PostgreSQL)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_NEON_HOST/sylvaan_db?sslmode=require"

# Get your free football API key from https://www.football-data.org/
FOOTBALL_API_KEY="your_api_key_here"
