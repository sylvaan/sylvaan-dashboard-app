datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model League {
  id        String     @id @default(uuid())
  code      String     @unique // e.g. "PL"
  name      String     // e.g. "Premier League"
  country   String     // e.g. "England"
  emblemUrl String?    // emblem logo
  standings Standing[]
  teams     Team[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Team {
  id        String     @id @default(uuid())
  apiId     Int        @unique // external API's team ID (important for sync!)
  name      String     @unique
  shortName String?
  tla       String?    // e.g. "LIV"
  crestUrl  String?
  venue     String?
  leagueId  String
  league    League     @relation(fields: [leagueId], references: [id])
  standings Standing[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Standing {
  id         String   @id @default(uuid())
  position   Int
  played     Int
  won        Int
  drawn      Int
  lost       Int
  gd         Int
  points     Int
  form       String[] // e.g. ["W", "D", "W"]
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id])
  leagueId   String
  league     League   @relation(fields: [leagueId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([leagueId, position])
  @@unique([leagueId, teamId])
}
